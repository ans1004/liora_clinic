# LIORA CLINIC - Apache Configuration
# PHP 8.4 환경 설정

# PHP 버전 설정 (Cafe24 New Autobahn 환경)
# AddHandler application/x-httpd-php84 .php

# UTF-8 인코딩
AddDefaultCharset UTF-8

# URL Rewriting (선택사항)
# RewriteEngine On
# RewriteBase /

# index.php를 기본 파일로 설정
DirectoryIndex index.php index.html

# 보안 설정
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# PHP 설정 파일 보호
<FilesMatch "^(config|db-config)\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# 에러 페이지 설정 (선택사항)
# ErrorDocument 404 /404.php
# ErrorDocument 500 /500.php






